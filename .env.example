DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/scraping_masive
PORT=8000
TEMP_DIR=/app/temp
LOG_DIR=/app/logs
# ============================================================================
# Authentication
# ============================================================================
# Endpoints /internal/* — usada por n8n y workflows automatizados
# Header: X-Internal-Api-Key
INTERNAL_API_KEY=change-me-internal
# Endpoints /api/v1/* — consumo personal (frontend, postman, curl)
# Header: X-Api-Key
API_KEY=change-me-public
# ============================================================================
# OpenAI — embeddings + LLM rerank del pipeline de ranking
# ============================================================================
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_RERANK_MODEL=gpt-4o-mini
RANK_TOP_K=50
RANK_MIN_SCORE=0
OPENAI_CV_MODEL=gpt-4o-mini
OPENAI_INGEST_MODEL=gpt-4o-mini
OPENAI_DIGEST_MODEL=gpt-4o-mini
CV_BATCH_CONCURRENCY=5
CV_OUTPUT_DIR=/app/output/cv
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_PRICE_PER_MTOK_INPUT=0.042
JEV_MAX_CONCURRENCY=20
JEV_DESCRIPTION_MAX_CHARS=2000
JEV_DESCRIPTION_HEAD_CHARS=500
JEV_WEIGHT_TECH=0.40
JEV_WEIGHT_AREA=0.20
JEV_WEIGHT_ROLE=0.20
JEV_WEIGHT_SENIORITY=0.20
JEV_BLOCKER_NOUL_THRESHOLD=0.85
JEV_CHOICE_BLOCKER_CONFIDENCE=0.80
JEV_DISCARD_SCORE=35
JEV_DISCARD_UPPER_QUANTILE=0.90
JEV_YEARS_GAP_TOLERANCE=1.0
JEV_YEARS_GAP_SENIORITY_FIT=0.25
JEV_LANGUAGE_GAP_BLOCKS=false
REFRESH_QUERIES=desarrollador full stack,desarrollador backend,desarrollador frontend
REFRESH_LOCATION=Chile
REFRESH_MAX_PAGES=2
